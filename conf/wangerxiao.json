{--primary-color:#4a90e2;--error-color:#e74c3c;--text-color:#2c3e50;--bg-color:#f5f6fa;--tooltip-offset:100px;--tooltip-arrow-size:clamp(3px,1.5vw,8px);--tooltip-padding:clamp(2px,1.5vw,8px)clamp(4px,2.5vw,12px);--tooltip-font-size:clamp(8px,2.5vw,12px);--tooltip-max-width:clamp(60px,25vw,140px)}body,html{margin:0;padding:0;height:100%;font-family:'Segoe UI',Arial,sans-serif;background:var(--bg-color);color:var(--text-color);display:flex;flex-direction:column;justify-content:center;align-items:center;overflow-x:hidden}.ipxinxi{background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);box-shadow:0 8px 32px rgba(31,38,135,0.15);position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:clamp(10px,3vw,15px)clamp(20px,6vw,30px);border-radius:clamp(8px,2vw,12px);transition:all 0.3s ease;border:1px solid rgba(255,255,255,0.18);z-index:1000;text-align:center;width:clamp(80%,90vw,auto);font-size:clamp(0.9rem,2.5vw,1rem)}.ipxinxi:hover{transform:translateX(-50%)translateY(-2px);box-shadow:0 12px 40px rgba(31,38,135,0.2)}.center-container{display:flex;flex-direction:column;align-items:center;gap:clamp(8px,2vw,14px)}.diag-copy-btn{padding:clamp(7px,2vw,11px)clamp(16px,4vw,24px);border:1px solid rgba(44,62,80,0.28);border-radius:999px;background:rgba(255,255,255,0.92);color:#2c3e50;cursor:pointer;font-size:clamp(0.85rem,2.2vw,0.95rem);font-weight:600;letter-spacing:0.02em;box-shadow:0 4px 14px rgba(0,0,0,0.08);transition:all 0.22s ease}.diag-copy-btn:hover{border-color:rgba(44,62,80,0.42);box-shadow:0 7px 18px rgba(0,0,0,0.12);transform:translateY(-1px)}.diag-copy-btn:active{transform:translateY(0);box-shadow:0 3px 9px rgba(0,0,0,0.1)}.images-container{display:flex;justify-content:center;align-items:center;gap:clamp(15px,4vw,20px);margin:clamp(20px,8vw,40px)0;perspective:1000px;flex-wrap:wrap}.images-container img{opacity:0;transform:translateY(20px);transition:all 0.5s cubic-bezier(0.4,0,0.2,1);height:auto}.电脑,.SCDN{width:70px}.箭头_右,.链接{width:40px}.叉{width:25px}.服务器{width:60px}@keyframes floatAnimation{0%,100%{transform:translate3d(0,0,0)rotate(0deg)}25%{transform:translate3d(0,-10px,5px)rotate(2deg)}75%{transform:translate3d(0,10px,-5px)rotate(-2deg)}}@keyframes fadeInScale{from{opacity:0;transform:scale(0.8)translateY(20px)}to{opacity:1;transform:scale(1)translateY(0)}}.电脑,.服务器,.SCDN,.链接{animation:fadeInScale 0.5s forwards,floatAnimation 6s ease-in-out infinite}.SCDN{animation-delay:0s,-2s}.链接{animation-delay:0s,-3s}.服务器{animation-delay:0s,-4s}.箭头_右,.叉{animation:fadeInScale 0.5s forwards;transform-origin:center;transition:transform 0.3s ease}.箭头_右{animation-delay:0.3s}.叉{animation-delay:0.6s}.箭头_右:hover{transform:scale(1.2)}.叉:hover{transform:rotate(180deg)scale(1.2)}h1{font-weight:600;font-size:clamp(2.5rem,8vw,4rem);background:linear-gradient(135deg,var(--primary-color),var(--error-color));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;margin:20px 0;animation:fadeInScale 0.8s forwards}footer{position:fixed;bottom:0;width:100%;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);padding:clamp(12px,3vw,15px)0;box-shadow:0-4px 20px rgba(0,0,0,0.1);transition:transform 0.3s ease;display:flex;justify-content:center;align-items:center}footer:hover{transform:translateY(-2px)}.left-content,.right-content{flex:1;text-align:center;padding:0 clamp(10px,4vw,20px);position:relative;display:flex;align-items:center;justify-content:center;gap:clamp(5px,2vw,10px)}.left-content::after{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%);height:80%;width:1px;background:linear-gradient(to bottom,transparent,var(--text-color),transparent)}h2{font-weight:600;color:var(--primary-color);margin:0;font-size:clamp(1rem,2.5vw,1.1rem)}p{margin:0;color:var(--text-color);font-size:clamp(0.9rem,2vw,1rem)}.help-button{position:fixed;right:0;top:50%;transform:translateY(-50%);background:linear-gradient(135deg,var(--primary-color),#2980b9);color:white;padding:clamp(3px,1.5vw,8px)clamp(6px,3vw,15px);border:none;border-radius:clamp(3px,1vw,5px)0 0 clamp(3px,1vw,5px);cursor:pointer;font-size:clamp(9px,2.5vw,13px);font-weight:bold;box-shadow:-2px 2px 10px rgba(0,0,0,0.2);transition:all 0.3s ease;z-index:999;text-decoration:none}.help-button:hover{padding-right:clamp(8px,4vw,18px);background:linear-gradient(135deg,#2980b9,var(--primary-color))}.tooltip{position:fixed;right:var(--tooltip-offset,100px);top:50%;transform:translateY(-50%);background:white;padding:var(--tooltip-padding);border-radius:clamp(3px,1vw,5px);box-shadow:0 4px 15px rgba(0,0,0,0.1);font-size:var(--tooltip-font-size);color:var(--text-color);opacity:0;visibility:hidden;transition:all 0.3s ease;z-index:1000;max-width:var(--tooltip-max-width)}.tooltip::after{content:'';position:absolute;right:calc(-1*var(--tooltip-arrow-size));top:50%;transform:translateY(-50%);border-width:var(--tooltip-arrow-size)0 var(--tooltip-arrow-size)var(--tooltip-arrow-size);border-style:solid;border-color:transparent transparent transparent white}.tooltip.show{opacity:1;visibility:visible;animation:pulse 1s infinite}@keyframes pulse{0%,100%{transform:translateY(-50%)scale(1)}50%{transform:translateY(-50%)scale(1.05)}}</style></head><body><div class="ipxinxi"><span class="inline-block md:block heading-ray-id font-mono text-15 lg:text-sm lg:leading-relaxed">您的IP:<span id="diag-client-ip">168.138.201.195</span>&bull;<br></span><span class="inline-block md:block heading-ray-id font-mono text-15 lg:text-sm lg:leading-relaxed">节点IP:<span id="diag-node-ip">178.236.38.1</span><br></span></div><div class="images-container"><img src="https://assets.rnmcnm.com/assets/img/cdnfly/电脑.svg"class="电脑"alt="电脑"><img src="https://assets.rnmcnm.com/assets/img/cdnfly/箭头_右.svg"class="箭头_右"alt="箭头_右"><a href="https://www.cdn1.vip"target="_blank"><img src="https://assets.rnmcnm.com/assets/img/cdnfly/SCDN.svg"class="SCDN"alt="SCDN"></a><img src="https://assets.rnmcnm.com/assets/img/cdnfly/%E9%93%BE%E6%8E%A5.svg"class="链接"alt="链接"><img src="https://assets.rnmcnm.com/assets/img/cdnfly/叉.svg"class="叉"alt="叉"><img src="https://assets.rnmcnm.com/assets/img/cdnfly/服务器.svg"class="服务器"alt="服务器"></div><div class="center-container"><h1><span data-translate="error">Error</span><span>504</span></h1><button type="button"class="diag-copy-btn"id="diag-copy-btn"aria-label="复制诊断信息到剪贴板">诊断信息</button></div><footer><div class="left-content"><h2>什么问题？</h2><p>CDN节点请求源服务器超时！</p></div><div class="right-content"><h2>如何解决？</h2><p>请检查该站点源服务器回源端口是否通畅或拦截了CDN节点！</p></div></footer><a href="https://www.rnmcnm.com/archives/3479"class="help-button">疑难杂症</a><div class="tooltip">点"疑难杂症"查解决方法</div><script>function copyDiagnosticInfo(){var clientEl=document.getElementById('diag-client-ip');var nodeEl=document.getElementById('diag-node-ip');var clientIp=clientEl?clientEl.textContent.replace(/\s+/g,' ').trim():'';var nodeIp=nodeEl?nodeEl.textContent.replace(/\s+/g,' ').trim():'';var lines=['您的IP: '+clientIp,'节点IP: '+nodeIp,'当前URL: '+window.location.href,'浏览器版本: '+navigator.userAgent,'报错代码: 504'];var text=lines.join('\n');var btn=document.getElementById('diag-copy-btn');var done=function(){if(!btn)return;var prev=btn.textContent;btn.textContent='已复制';setTimeout(function(){btn.textContent=prev},2000)};if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done).catch(function(){fallbackCopyText(text,done)})}else{fallbackCopyText(text,done)}}function fallbackCopyText(text,onOk){var ta=document.createElement('textarea');ta.value=text;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');if(onOk)onOk()}catch(e){}document.body.removeChild(ta)}function updateTooltipPosition(){const button=document.querySelector('.help-button');const tooltip=document.querySelector('.tooltip');if(button&&tooltip){const buttonWidth=button.offsetWidth;const gap=Math.max(15,window.innerWidth*0.02);const tooltipRight=buttonWidth+gap;tooltip.style.setProperty('--tooltip-offset',tooltipRight+'px')}}document.addEventListener('DOMContentLoaded',function(){const images=document.querySelectorAll('.images-container img');images.forEach((img,index)=>{setTimeout(()=>{img.style.opacity='1';img.style.transform='translateY(0)'},index*200)});const ipxinxi=document.querySelector('.ipxinxi');ipxinxi.style.opacity='0';ipxinxi.style.transform='translateX(-50%) translateY(-20px)';setTimeout(()=>{ipxinxi.style.transition='all 0.5s ease';ipxinxi.style.opacity='1';ipxinxi.style.transform='translateX(-50%) translateY(0)'},300);updateTooltipPosition();window.addEventListener('resize',updateTooltipPosition);var diagBtn=document.getElementById('diag-copy-btn');if(diagBtn)diagBtn.addEventListener('click',copyDiagnosticInfo)});document.addEventListener('mousemove',function(e){const images=document.querySelectorAll('.images-container img');const xAxis=(window.innerWidth/2-e.pageX)/25;const yAxis=(window.innerHeight/2-e.pageY)/25;images.forEach((img)=>{img.style.transform=`translate(${xAxis}px,${yAxis}px)`})});function showTooltip(){const tooltip=document.querySelector('.tooltip');tooltip.classList.add('show');setTimeout(()=>tooltip.classList.remove('show'),3000)}setInterval(showTooltip,5000);setTimeout(showTooltip,1000);</script></body></html>